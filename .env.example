# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PALO ALTO NETWORKS MCP SERVER
# ==============================================================================

# Endereço HTTPS do Firewall PAN-OS ou Panorama
PANOS_HOST=https://192.168.1.1

# Chave de API gerada no PAN-OS (ou credenciais para geração dinâmica)
PANOS_API_KEY=CHANGE_ME
PANOS_USERNAME=
PANOS_PASSWORD=

# Validação TLS/SSL (defina como true em produção; use false somente em laboratório com certificado autoassinado)
PANOS_VERIFY_SSL=true

# Timeouts de conexão e requisição (segundos)
PANOS_TIMEOUT=30
PANOS_CONNECT_TIMEOUT=10

# Contexto padrão de dispositivo e virtual system
PANOS_DEFAULT_DEVICE=
PANOS_DEFAULT_VSYS=vsys1

# Conexão opcional com Panorama centralizado
PANORAMA_HOST=
PANORAMA_API_KEY=

# Controles de Segurança & RBAC
MCP_AUTH_ENABLED=true
MCP_REQUIRE_CONFIRMATION=true

# Políticas de permissão de escrita e modificação de produção
ALLOW_WRITE_OPERATIONS=false
ALLOW_COMMIT=false
ALLOW_REBOOT=false

# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
